PREFIX fd:   <https://krr.example.org/fd/ontology#>
PREFIX fdr:  <https://krr.example.org/fd/data/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

# CQ8 | PROPERTY PATH | Which airports are reachable from Islamabad over the route network (any number of hops, either direction)?
SELECT DISTINCT ?iata
WHERE {
  fdr:airport-OPIS (fd:connectedTo|^fd:connectedTo)+ ?x .
  ?x fd:iataCode ?iata .
  FILTER (?x != fdr:airport-OPIS)
}
ORDER BY ?iata
