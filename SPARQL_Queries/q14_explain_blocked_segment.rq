PREFIX fd:   <https://krr.example.org/fd/ontology#>
PREFIX fdr:  <https://krr.example.org/fd/data/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

# CQ13 | EXPLAINABILITY | Why is the segment Karachi -> Dubai not feasible? Lists every blocking cause and range violation
SELECT ?reasonType ?reason
WHERE {
  { fdr:segment-OPKC-OMDB fd:blockedBy ?r . ?r rdfs:label ?reason . BIND("blocked by active zone/hazard" AS ?reasonType) }
  UNION
  { fdr:segment-OPKC-OMDB fd:exceedsRangeOf ?r . ?r rdfs:label ?reason . BIND("distance exceeds aircraft range" AS ?reasonType) }
}
