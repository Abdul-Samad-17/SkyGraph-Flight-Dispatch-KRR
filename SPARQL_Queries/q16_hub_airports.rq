PREFIX fd:   <https://krr.example.org/fd/ontology#>
PREFIX fdr:  <https://krr.example.org/fd/data/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

# CQ15 | INFERENCE (R6, aggregation) | Which airports are hubs and how many segments do they have?
SELECT ?iata ?name (COUNT(DISTINCT ?s) AS ?segments)
WHERE {
  ?a a fd:HubAirport ; fd:iataCode ?iata ; rdfs:label ?name .
  { ?s fd:connectsFrom ?a } UNION { ?s fd:connectsTo ?a }
}
GROUP BY ?iata ?name
ORDER BY DESC(?segments)
